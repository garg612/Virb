// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  username    String   @unique
  password    String?
  googleId    String?  @unique
  avatar      String?
  conversation Conversation[]
  message     Message[]
  adminGroups Conversation[] @relation("GroupAdmin")
  refreshToken String?
  accessToken  String?
  outgoingCalls call[] @relation("Caller")
  incommingCalls call[] @relation("Receiver")
  createdAt   DateTime @default(now())
}

model Conversation {
  id Int @id @default(autoincrement())
  isGroup Boolean @default(false)
  groupName String?
  groupAvatar String?
  groupAdminId Int?
  groupAdmin User? @relation("GroupAdmin", fields: [groupAdminId], references: [id])
  participants User[]
  messages Message[]
  acceptedUserIds Int[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Message{
  id        Int    @id @default(autoincrement())

  content   String?
  image     String?

  SenderId    Int
  sender     User   @relation(fields:[SenderId],references:[id])

  conversationId Int
  conversation     Conversation @relation(fields: [conversationId], references: [id])
  replyToId Int?
  replyTo Message? @relation("ReplyMessage",fields:[replyToId],references:[id])
  replies Message[] @relation("ReplyMessage")
  isSeen      Boolean @default(false)
  seenAt      DateTime?
  isDeleted Boolean @default(false)
  deletedAt DateTime?
  isEdited Boolean @default(false)
  editedAt DateTime?

  createdAt   DateTime @default(now())
}

model call{
  id Int @id @default(autoincrement())

  callerId Int
  caller User @relation("Caller",fields:[callerId],references:[id])
  receiverId Int
  receiver User @relation("Receiver",fields:[receiverId],references:[id])
  type String
  //audio or video
  
  status String @default("missed")
  //missed accepted rejected ended 

  startedAt DateTime @default(now())
  endedAt  DateTime?

  duration Int?
  //seconds

  createdAt DateTime @default(now())

}